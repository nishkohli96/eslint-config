{
  "name": "@nish1896/eslint-config-root",
  "version": "5.0.0",
  "description": "eslint and stylistic rules to help you focus more on the code logic, while they take care of the code formatting",
  "author": "Nishant Kohli",
  "private": true,
  "scripts": {
    "setup": "sh ./scripts/setup.sh",
    "pkgs": "sh ./scripts/pack.sh",
    "doc": "pnpm --filter @nish1896/eslint-config-docs start",
    "docs:build": "pnpm --filter @nish1896/eslint-config-docs build",
    "js-10:lint": "pnpm --filter js-eslint-10 lint",
    "next-10:lint": "pnpm --filter next-eslint-10 lint",
    "vite-10:lint": "pnpm --filter vite-eslint-10 lint"
  },
  "devDependencies": {
    "rimraf": "^6.1.3"
  },
  "homepage": "https://nish1896-eslint-config.vercel.app/",
  "repository": {
    "url": "git+https://github.com/nishkohli96/eslint-config.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.9.0"
}
