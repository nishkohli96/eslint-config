{
  "name": "@nish1896/eslint-flat-config",
  "version": "4.0.0",
  "description": "Linting rules configured for ESLint v10 and above to catch potential errors and ensure consistent code formatting.",
  "author": "Nishant Kohli",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "type": "module",
  "main": "./lib/js/index.mjs",
  "types": "./lib/js/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/js/index.mjs",
      "types": "./lib/js/index.d.ts"
    },
    "./package.json": {
      "import": "./package.json",
      "require": "./package.json"
    },
    "./js": {
      "import": "./lib/js/index.mjs",
      "types": "./lib/js/index.d.ts"
    },
    "./jsx": {
      "import": "./lib/jsx/index.mjs",
      "types": "./lib/jsx/index.d.ts"
    },
    "./ts": {
      "import": "./lib/ts/index.mjs",
      "types": "./lib/ts/index.d.ts"
    },
    "./next": {
      "import": "./lib/next/index.mjs",
      "types": "./lib/next/index.d.ts"
    },
    "./next-ts": {
      "import": "./lib/next-ts/index.mjs",
      "types": "./lib/next-ts/index.d.ts"
    }
  },
  "scripts": {
    "link:local": "npm link",
    "unlink:local": "npm unlink @nish1896/eslint-flat-config"
  },
  "homepage": "https://nish1896-eslint-config.vercel.app/",
  "repository": {
    "url": "git+https://github.com/nishkohli96/eslint-config.git"
  },
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@eslint/js": ">=10",
    "eslint": ">=10"
  },
  "license": "MIT",
  "keywords": [
    "@nish1896",
    "@nish1896/eslint-flat-config",
    "eslint",
    "eslint10",
    "eslint-10",
    "eslint-v10",
    "eslint10-config",
    "eslintconfig",
    "eslint-config",
    "eslint-config-flat",
    "eslint-flat-config",
    "flat-config",
    "eslint flat config",
    "eslint-config-jsx",
    "eslint-config-react",
    "eslint-react",
    "react",
    "nextjs",
    "typescript",
    "typescript-eslint",
    "lint-config",
    "lint-rules",
    "react-eslint",
    "shareable-config",
    "code-style",
    "code-quality",
    "eslint-stylistic",
    "eslint-style",
    "stylistic-eslint"
  ]
}
